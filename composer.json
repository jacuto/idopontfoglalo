{
  "name": "jacuto/idopontfoglalo",
  "description": "Ráérő szalon időpontfoglaló – PHP 8.2 / Laravel",
  "type": "project",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "platform": {
      "php": "8.2.35"
    },
    "sort-packages": true,
    "preferred-install": "dist"
  },
  "scripts": {
    "test": "@php vendor/bin/phpunit"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "license": "proprietary"
}
