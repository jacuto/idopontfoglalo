APP_NAME=Ráérő
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://foglalo.digitmarketing.hu
SESSION_SECURE_COOKIE=true
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
ADMIN_PASSWORD_HASH=

# Central OAuth / SMS / SMTP: edit only in /foadmin or this private .env.
# Salon billing/payment keys remain under provider Settings / Connections.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Ráérő
BILLINGO_API_KEY=
BILLINGO_BLOCK_ID=
SZAMLAZZ_AGENT_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BULKGATE_APPLICATION_ID=
BULKGATE_APPLICATION_TOKEN=
BULKGATE_SENDER_TYPE=gSystem
BULKGATE_SENDER_VALUE=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0
ADMIN_GOOGLE_EMAILS=
ADMIN_FACEBOOK_IDS=

# Central platform subscription credentials, separate from a salon's payment account.
PLATFORM_STRIPE_SECRET_KEY=
PLATFORM_STRIPE_PRICE_ID=
PLATFORM_STRIPE_WEBHOOK_SECRET=

# Separate operator account (also editable under /foadmin / Connections).
PLATFORM_ADMIN_PASSWORD_HASH=
PLATFORM_BILLINGO_API_KEY=
PLATFORM_BILLINGO_BLOCK_ID=
PLATFORM_MAIL_HOST=
PLATFORM_MAIL_PORT=587
PLATFORM_MAIL_USERNAME=
PLATFORM_MAIL_PASSWORD=
PLATFORM_MAIL_FROM_ADDRESS=
PLATFORM_MAIL_FROM_NAME=Ráérő

# Sign in with Apple (Services ID, Team ID, Key ID and private .p8 contents with \n escapes)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
ADMIN_APPLE_IDS=
